# ==========================================
# Aura Editorial Agency - Client Portal MVP
# Environment Configuration Template
# ==========================================
# Copy this file to .env.local and populate with your project credentials.
# Do NOT commit actual secrets or production keys into version control.

# Supabase Public Configuration (Required for Client and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Server-side ONLY - NEVER expose to browser)
# Keep empty or set in secure server environments for administrative actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
